# =====================================================================
# ANSHUCORE (https://anshucore.in) — ENVIRONMENT VARIABLES TEMPLATE
# Add these variables in Vercel Project Settings > Environment Variables
# For local development, copy to .env.local and fill in your values.
# =====================================================================

# 1. UPSTASH REDIS (Persistent Cloud Storage for Vercel Serverless)
# Create a free database at https://console.upstash.com (10,000 commands/day free tier)
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token_here

# 2. ADMINISTRATOR AUTHENTICATION & SECURITY
# Used to cryptographically sign HttpOnly admin sessions (HMAC SHA-256)
ADMIN_SESSION_SECRET=your_random_64_character_session_secret
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_secure_admin_password_here

# 3. CANONICAL BASE URL
NEXT_PUBLIC_CANONICAL_URL=https://anshucore.in

# 4. GITHUB RELEASES (Optional — increases API rate limit for live APK stats)
# GITHUB_ACCESS_TOKEN=ghp_your_github_personal_access_token

# 5. PAYMENT GATEWAY (Optional: Razorpay Integration for Institutional Subscriptions)
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
